<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude unencrypted financial SQLite database and API key shared prefs from cloud backups -->
        <exclude domain="database" path="folio_expenses.db"/>
        <exclude domain="database" path="folio_expenses.db-shm"/>
        <exclude domain="database" path="folio_expenses.db-wal"/>
        <exclude domain="sharedpref" path="folio_ai_prefs.xml"/>
        <exclude domain="sharedpref" path="folio_security_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Allow full local device-to-device migration -->
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
